<?xml version="1.0" encoding="utf-8"?>
<!-- Template: build-msix.ps1 fills the {{TOKENS}}. Identity Name, Publisher and
     PublisherDisplayName must match the values Partner Center shows under
     Product management > Product identity, or the Store rejects the upload. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity Name="{{IDENTITY_NAME}}" Publisher="{{PUBLISHER}}"
            Version="{{VERSION}}" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>SysPerf</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Self-improving Windows 11 performance dashboard.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="SysPerf" Executable="SysPerf\SysPerf.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="SysPerf"
        Description="Measures this PC, finds what slows it down, and fixes what it safely can."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square71x71Logo="Assets\SmallTile.png" Square310x310Logo="Assets\LargeTile.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Required for a desktop (Win32) app. Partner Center asks why: SysPerf runs
         PowerShell and WSL probes to measure the machine. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
