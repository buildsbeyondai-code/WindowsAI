#!/bin/sh
# Full suite before anything reaches GitHub (the edit loop runs only the
# affected tests: tools/affected_tests.py). Enable once per clone:
#   git config core.hooksPath tools/hooks
# Skip in an emergency with: git push --no-verify
set -e
cd "$(git rev-parse --show-toplevel)"
# Git exports GIT_DIR to hooks run from a worktree; tests that build their own
# repositories with `git -C <tmp>` would otherwise commit to this one.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY \
      GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_NAMESPACE GIT_PREFIX
if [ -x ../venv/Scripts/python.exe ]; then PY=../venv/Scripts/python.exe
elif [ -x .venv/bin/python ]; then PY=.venv/bin/python
else PY=python3; fi
echo "pre-push: ruff + full test suite with $PY"
"$PY" -m ruff check src tests tools
if [ -n "$LOCALAPPDATA" ]; then
  "$PY" -m pytest -q -rs -p no:cacheprovider --basetemp="$LOCALAPPDATA/SysPerf/pt-tmp"
else
  "$PY" -m pytest -q -rs -p no:cacheprovider
fi
# The self-evolution baseline: the same suite inside its sandbox (bubblewrap),
# which CI does not reproduce. Skips itself where no sandbox backend exists.
"$PY" tools/sandbox_suite.py
