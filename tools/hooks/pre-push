#!/bin/sh
# Full suite before anything reaches GitHub (the edit loop runs only the
# affected tests: tools/affected_tests.py). Enable once per clone:
#   git config core.hooksPath tools/hooks
# Skip in an emergency with: git push --no-verify
set -e
cd "$(git rev-parse --show-toplevel)"
if [ -x ../venv/Scripts/python.exe ]; then PY=../venv/Scripts/python.exe
elif [ -x .venv/bin/python ]; then PY=.venv/bin/python
else PY=python3; fi
echo "pre-push: ruff + full test suite with $PY"
"$PY" -m ruff check src tests tools
if [ -n "$LOCALAPPDATA" ]; then
  "$PY" -m pytest -q -rs -p no:cacheprovider --basetemp="$LOCALAPPDATA/SysPerf/pt-tmp"
else
  "$PY" -m pytest -q -rs -p no:cacheprovider
fi
